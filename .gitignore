# ====================================================================
# ARCHIVOS GLOBALES DEL REPOSITORIO
# ====================================================================
.DS_Store
Thumbs.db
*.log
**/__pycache__/
*.py[cod]
backend/.venv/
backend/*.egg-info/
backend/.pytest_cache/
backend/data/*.sqlite3
backend/data/*.sqlite3-*

# Configuraciones locales de IDEs (Android Studio, IntelliJ, VSCode, etc.)
**/.idea/
**/*.iml
**/.vscode/

# ====================================================================
# REGLAS PARA PROYECTOS ANDROID (Aplica a scanwifi y futuros)
# ====================================================================
**/.gradle/
**/local.properties
**/build/
**/captures/
**/.externalNativeBuild/
**/.cxx/

# Archivos generados y empaquetados
**/*.apk
**/*.ap_
**/*.aab
**/*.dex
**/*.class

# Archivos de firmas, claves y servicios (¡Seguridad!)
**/*.jks
**/*.keystore
**/google-services.json

